{
  "name": "fieldsynk-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:ios": "eas build -p ios",
    "build:android": "eas build -p android",
    "build:all": "eas build -p all",
    "submit:ios": "eas submit -p ios",
    "submit:android": "eas submit -p android",
    "type-check": "tsc --noEmit",
    "test": "node --test lib/*.test.ts",
    "web": "expo start --web --port 8081"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^57.0.14",
    "expo-asset": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.12",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.27.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-plugin-module-resolver": "^5.0.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens"
      ]
    }
  }
}
